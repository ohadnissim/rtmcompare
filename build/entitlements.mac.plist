<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Electron / JIT requirements -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- 5.2.2 (audit P1 / parent F5): library-validation stays disabled
         because the bundled Python's C-extensions carry their own
         signing chain mac wouldn't otherwise accept.
         disable-executable-page-protection was an over-broad inclusion
         and was REMOVED in 5.2.2 — Electron + bundled Python work
         without it. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- File access (drag-and-drop audio files) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Audio output -->
    <key>com.apple.security.device.audio-input</key>
    <false/>
</dict>
</plist>
