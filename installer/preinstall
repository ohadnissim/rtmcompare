#!/bin/bash
# Pre-install script — checks for Python 3 and installs Command Line Tools if needed

echo "Checking for Python 3..."

if command -v python3 &>/dev/null; then
    echo "Python 3 found: $(python3 --version)"
    exit 0
fi

echo "Python 3 not found. Installing Command Line Tools..."

# Trigger the macOS Command Line Tools installer
xcode-select --install 2>/dev/null

# Wait for it to complete (user will see a dialog)
echo "Waiting for Command Line Tools installation..."
until command -v python3 &>/dev/null; do
    sleep 5
done

echo "Python 3 installed successfully."
exit 0
